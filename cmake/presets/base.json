{
  "version": 10,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 31,
    "patch": 0
  },
  "$comment": "Base CMake presets for all platforms.",
  "configurePresets": [
    {
      "name": "default-cmake-config",
      "hidden": true,
      "description": "CMake Configuration",
      "cacheVariables": {
        "CMAKE_COMPILE_WARNING_AS_ERROR": {
          "type": "BOOL",
          "value": "OFF"
        },
        "CMAKE_EXPORT_COMPILE_COMMANDS": {
          "type": "BOOL",
          "value": "ON"
        },
        "CMAKE_COLOR_DIAGNOSTICS": {
          "type": "BOOL",
          "value": "ON"
        },
        "CMAKE_VERBOSE_MAKEFILE": {
          "type": "BOOL",
          "value": "ON"
        }
      }
    },
    {
      "name": "enable-warnings",
      "hidden": true,
      "description": "Enables CMake developer warnings for deprecated, uninitialized, unused variables.",
      "warnings": {
        "deprecated": true,
        "dev": true,
        "uninitialized": true,
        "unusedCli": true
      }
    },
    {
      "name": "default-build-folders",
      "hidden": true,
      "description": "Set the build and install directory.",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": {
          "type": "FILEPATH",
          "value": "${sourceDir}/out/install/${presetName}"
        }
      }
    },
    {
      "name": "ci-build-folders",
      "hidden": true,
      "description": "Set the build and install directory for CI system.",
      "binaryDir": "build",
      "installDir": "install",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": {
          "type": "FILEPATH",
          "value": "install"
        }
      }
    },
    {
      "name": "condition-is-ci",
      "hidden": true,
      "displayName": "CI-only configuration",
      "description": "This build is only available on a Continous Integration system.",
      "condition": {
        "type": "equals",
        "lhs": "$env{CI}",
        "rhs": "true"
      }
    },
    {
      "name": "generator-ninja-multi",
      "hidden": true,
      "description": "Set ninja multi-config as makefile generator.",
      "generator": "Ninja Multi-Config"
    },
    {
      "name": "generator-ninja",
      "hidden": true,
      "description": "Set ninja as makefile generator.",
      "generator": "Ninja"
    },
    {
      "name": "vcpkg-default-config",
      "hidden": true,
      "description": "Setup vcpkg on windows: toolchain, package install dir, verbosity.",
      "cacheVariables": {
        "VCPKG_ENABLED": {
          "type": "BOOL",
          "value": "ON"
        },
        "VCPKG_VERBOSE": {
          "type": "BOOL",
          "value": "ON"
        },
        "CMAKE_TOOLCHAIN_FILE": {
          "type": "FILEPATH",
          "value": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
        },
        "VCPKG_INSTALLED_DIR": {
          "type": "FILEPATH",
          "value": "${sourceDir}/vcpkg_installed/"
        },
        "X_VCPKG_APPLOCAL_DEPS_INSTALL": {
          "type": "BOOL",
          "value": "ON"
        }
      }
    },
    {
      "name": "address-sanitizer",
      "hidden": true,
      "cacheVariables": {
        "SANITIZE_ADDRESS": {
          "type": "BOOL",
          "value": "ON"
        }
      }
    },
    {
      "name": "thread-sanitizer",
      "hidden": true,
      "cacheVariables": {
        "SANITIZE_THREAD": {
          "type": "BOOL",
          "value": "ON"
        }
      }
    },
    {
      "name": "undefined-behavior-sanitizer",
      "hidden": true,
      "cacheVariables": {
        "SANITIZE_UB": {
          "type": "BOOL",
          "value": "ON"
        }
      }
    },
    {
      "name": "static-analysis",
      "hidden": true,
      "cacheVariables": {
        "STATIC_ANALYSIS": {
          "type": "BOOL",
          "value": "ON"
        }
      }
    },
    {
      "name": "coverage-using-clang",
      "hidden": true,
      "description": "Set Clang source-based coverage instrumentation flags (for Debug builds)",
      "cacheVariables": {
        "CMAKE_C_FLAGS": "-fprofile-instr-generate -fcoverage-mapping",
        "CMAKE_CXX_FLAGS": "-fprofile-instr-generate -fcoverage-mapping",
        "CMAKE_EXE_LINKER_FLAGS": "-fprofile-instr-generate",
        "CMAKE_SHARED_LINKER_FLAGS": "-fprofile-instr-generate",
        "CMAKE_MODULE_LINKER_FLAGS": "-fprofile-instr-generate"
      }
    }
  ]
}
