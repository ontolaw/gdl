{
  "version": 10,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 31,
    "patch": 0
  },
  "$comment": "CMake presets for Linux.",
  "include": [
    "base.json"
  ],
  "configurePresets": [
      {
        "name": "clang17-x64-linux-rel",
        "displayName": "Clang17 Release",
        "generator": "Ninja",
        "cacheVariables": {
          "CMAKE_BUILD_TYPE": "Release",
          "CMAKE_C_COMPILER": "clang-17",
          "CMAKE_CXX_COMPILER": "clang++-17"
        }
      },
      {
        "name": "clang17-x64-linux-dbg",
        "displayName": "Clang17 Debug",
        "generator": "Ninja",
        "cacheVariables": {
          "CMAKE_BUILD_TYPE": "Debug",
          "CMAKE_C_COMPILER": "clang-17",
          "CMAKE_CXX_COMPILER": "clang++-17"
        }
      },
      {
        "name": "condition-is-linux",
        "hidden": true,
        "displayName": "Linux-only configuration",
        "description": "This build is only available on Linux.",
        "condition": {
          "type": "equals",
          "lhs": "${hostSystemName}",
          "rhs": "Linux"
        }
      },
      {
        "name": "clang22-x64-linux",
        "hidden": true,
        "vendor": {
          "microsoft.com/VisualStudioSettings/CMake/1.0": {
            "intelliSenseMode": "linux-gcc-x64"
          }
        },
        "inherits": [
          "condition-is-linux",
          "default-cmake-config",
          "enable-warnings",
          "generator-ninja",
          "compiler-clang22-linux",
          "default-build-folders",
          "vcpkg-default-config",
          "vcpkg-triplet-x64-linux"
        ]
      },
    {
      "name": "vcpkg-triplet-x64-linux",
      "hidden": true,
      "description": "Set vcpkg target_triplet (shared | dynamic).",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": {
          "type": "BOOL",
          "value": "ON"
        },
        "VCPKG_TARGET_TRIPLET": {
          "type": "STRING",
          "value": "x64-linux"
        }
      },
      "inherits": [
        "vcpkg-default-config"
      ]
    },
    {
      "name": "compiler-gcc14-linux",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++-14"
      }
    },
    {
      "name": "compiler-gcc16-linux",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++-16"
      }
    },
    {
      "name": "compiler-gcc13-linux",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++-13"
      }
    },
    {
      "name": "compiler-clang22-linux",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang-22"
      }
    },
    {
      "name": "gcc14-x64-linux",
      "hidden": true,
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "intelliSenseMode": "linux-gcc-x64"
        }
      },
      "inherits": [
        "condition-is-linux",
        "default-cmake-config",
        "enable-warnings",
        "generator-ninja",
        "compiler-gcc14-linux",
        "default-build-folders",
        "vcpkg-default-config",
        "vcpkg-triplet-x64-linux"
      ]
    },
    {
      "name": "gcc13-x64-linux",
      "hidden": true,
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "intelliSenseMode": "linux-gcc-x64"
        }
      },
      "inherits": [
        "condition-is-linux",
        "default-cmake-config",
        "enable-warnings",
        "generator-ninja",
        "compiler-gcc13-linux",
        "default-build-folders",
        "vcpkg-default-config",
        "vcpkg-triplet-x64-linux"
      ]
    },
    {
      "name": "gcc16-x64-linux",
      "hidden": true,
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "intelliSenseMode": "linux-gcc-x64"
        }
      },
      "inherits": [
        "condition-is-linux",
        "default-cmake-config",
        "enable-warnings",
        "generator-ninja",
        "compiler-gcc16-linux",
        "default-build-folders",
        "vcpkg-default-config",
        "vcpkg-triplet-x64-linux"
      ]
    },
    {
      "name": "gcc14-x64-linux-rel",
      "displayName": "GCC14 Release",
      "inherits": "gcc14-x64-linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "gcc14-x64-linux-rdi",
      "displayName": "GCC14 RelWithDebInfo",
      "inherits": "gcc14-x64-linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "gcc14-x64-linux-dbg",
      "displayName": "GCC14 Debug",
      "inherits": "gcc14-x64-linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "gcc16-x64-linux-rel",
      "displayName": "GCC16 Release",
      "inherits": "gcc16-x64-linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "clang22-x64-linux-rel",
      "displayName": "Clang22 Release",
      "inherits": "clang22-x64-linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "clang22-x64-linux-rdi",
      "displayName": "Clang22 RelWithDebInfo",
      "inherits": "clang22-x64-linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "clang22-x64-linux-dbg",
      "displayName": "Clang22 Debug",
      "inherits": "clang22-x64-linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "clang22-x64-linux-cov",
      "displayName": "Clang22 Coverage",
      "inherits": [
        "clang22-x64-linux",
        "coverage-using-clang"
      ]
    },
    {
      "name": "clang22-x64-linux-dbg-cov",
      "displayName": "Clang22 Debug (Coverage)",
      "inherits": "clang22-x64-linux-cov",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ]
}
